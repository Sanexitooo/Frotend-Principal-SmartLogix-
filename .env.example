# Variables de Entorno - SmartLogix
# Copia este archivo como .env y completa los valores

# API Key de OpenRouter para el chatbot IA (reemplaza a Gemini)
# Obtén tu key gratis en: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# Modelo de OpenRouter (default: mistralai/mistral-7b-instruct:free)
# VITE_OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# URL del dashboard (producción, desarrollo, etc.)
VITE_DASHBOARD_URL=http://localhost:5173

# URL del sitio (para HTTP-Referer en OpenRouter)
VITE_SITE_URL=http://localhost:8080
